# Optional account system. Without Supabase, a public alpha can still expose
# invitation-scoped client access while protecting owner operations with a
# server-side SHA-256 access-code hash.
SUPABASE_URL=
# Preferred for current Supabase projects. This is safe to expose to the
# browser; authorization remains server-enforced by Legacy OS.
SUPABASE_PUBLISHABLE_KEY=
# Legacy compatibility only. Leave blank when using a publishable key.
SUPABASE_ANON_KEY=
OWNER_EMAILS=
OWNER_ACCESS_CODE_HASH=
# OWNER_EMAILS and the access-code hash are transition / recovery controls.
# Normal owner authorization is stored in Supabase workspace_memberships.

# Stage 34 production reasoning runtime. The secret is server-only. Legacy OS
# remains the system of record for memory, policies, evidence, workflows,
# authority, and outcomes. Set the model explicitly for deliberate upgrades.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VISION_MODEL=
AI_REQUEST_TIMEOUT_MS=45000
AI_MAX_OUTPUT_TOKENS=1800

# Compatibility adapter for another OpenAI-compatible provider. Leave these
# blank when using the OpenAI settings above.
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Optional separate vision-capable model used for permitted image analysis.
AI_VISION_MODEL=

# Optional Instagram professional-account observation connection.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=
SOCIAL_TOKEN_ENCRYPTION_KEY=

# Owner-connected Google Workspace adapters. Use one OAuth web client with the
# exact callback URL ending in /api/connectors/google/callback. Credentials and
# OAuth state secrets are server-only; the encryption key must decode to 32 bytes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_CALENDAR_ID=primary
CONNECTOR_TOKEN_ENCRYPTION_KEY=
CONNECTOR_OAUTH_STATE_SECRET=

# Stripe Checkout. Use restricted test credentials for alpha. Keep live
# payments locked until the production launch checklist is approved.
STRIPE_RESTRICTED_KEY=
# Compatibility fallback only; prefer a restricted key above.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_PAYMENTS_ENABLED=false

# Server-only bearer secret used by a hosted scheduler to wake the durable worker.
AUTOMATION_WORKER_SECRET=
